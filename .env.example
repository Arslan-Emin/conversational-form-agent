# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM ---
# Which provider to use: deepseek | openai
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
# enabled = model reasons before answering (slower, more tokens); disabled = faster, cheaper
DEEPSEEK_THINKING=disabled

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Jotform (used from step 4 on) ---
JOTFORM_API_KEY=
JOTFORM_FORM_ID=
# Use https://eu-api.jotform.com for EU accounts
JOTFORM_BASE_URL=https://api.jotform.com

# --- Tracing (JSONL events for every LLM call, tool call and turn) ---
TRACE_ENABLED=true
TRACE_DIR=logs/traces
# Include message text and tool arguments (may contain personal data)
TRACE_INCLUDE_CONTENT=false
# Optional: also send events to the eval platform (github.com/Arslan-Emin/llm-eval-platform),
# e.g. http://127.0.0.1:8700/v1/events while `evalplat serve` runs. Empty = files only.
TRACE_HTTP_URL=
TRACE_HTTP_TOKEN=

# --- RAG ---
# fastembed model id; leave empty for the default (multilingual mpnet, ~1 GB).
# On hosts with little RAM: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_MODEL=

# --- Public demo limits (leave empty for no limit) ---
DEMO_MAX_MESSAGES=
DAILY_BUDGET_USD=
