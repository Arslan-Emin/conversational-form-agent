      "category": "normal",
      "description": "All four fields in one Turkish message, then confirmation.",
      "turns": [
        {"user": "Merhaba, ben Ali Veli, telefonum 0532 123 45 67. Pazartesi saat 11:00 için randevu istiyorum, sol alt dişim ağrıyor."},
        {"user": "Evet, onaylıyorum."}
      ],
      "final": {
        "fields": {
          "full_name": "Ali Veli",
          "phone": "0532 123 45 67",
          "appointment_datetime": "2026-11-23 11:00",
          "complaint": {"contains_any": ["ağrı"]}
        },
        "submitted": true
      }
    },
